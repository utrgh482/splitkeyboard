/*
 * DNerd-style Korean split keyboard, wired (TRRS/UART) split.
 * Controller: SuperMini nRF52840 (pro-micro pinout, build as nice_nano_v2).
 * Matrix col2row: col -> switch -> diode anode, cathode (band) -> row.
 *   cols: D4 D5 D6 D7 D8 D9 D10 D16   (right half uses all 8, left uses 7)
 *   rows: D21 D20 D19 D18 D15 D14
 *   split UART: TX = D1, RX = D0 (pro_micro_serial), crossed on the right PCB.
 */
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };

    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        transform = <&default_transform>;
        kscan = <&kscan0>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <15>;
        rows = <6>;
        // Left: cols 0-6, right: cols 7-14 (col-offset 7 in right overlay).
        map = <
// F row:  Esc F1 F2 F3 F4 | F5 F6 F7 F8 F9 F10 F11 F12
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)                  RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)
// num:   ` 1 2 3 4 5 6 | 7 8 9 0 - = Bksp
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)  RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
// top:   Tab Q W E R T | Y U I O P [ ] \
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)          RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14)
// home:  Caps A S D F G | H J K L ; ' Enter
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)          RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)
// bot:   LShift Z X C V B | B N M , . / RShift Up
RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)          RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13) RC(4,14)
// mods:  LCtrl LWin LAlt RAlt | RWin RCtrl Left Down Right
RC(5,0) RC(5,1) RC(5,2) RC(5,3)                          RC(5,7) RC(5,8) RC(5,9) RC(5,10) RC(5,11)
// thumbs: L1 L2 | R1 R2
RC(0,5) RC(0,6)                                          RC(5,12) RC(5,13)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    wired_split {
        compatible = "zmk,wired-split";
        device = <&pro_micro_serial>;
    };
};

&pro_micro_serial {
    status = "okay";
};
