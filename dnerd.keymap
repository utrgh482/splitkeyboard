#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define FN 1

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
// F row
&kp ESC   &kp F1  &kp F2  &kp F3  &kp F4                      &kp F5  &kp F6  &kp F7  &kp F8  &kp F9    &kp F10   &kp F11   &kp F12
// numbers
&kp GRAVE &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6      &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS &kp EQUAL &kp BSPC
// top
&kp TAB   &kp Q   &kp W   &kp E   &kp R   &kp T               &kp Y   &kp U   &kp I   &kp O   &kp P     &kp LBKT  &kp RBKT  &kp BSLH
// home
&kp CAPS  &kp A   &kp S   &kp D   &kp F   &kp G               &kp H   &kp J   &kp K   &kp L   &kp SEMI  &kp SQT   &kp RET
// bottom
&kp LSHFT &kp Z   &kp X   &kp C   &kp V   &kp B               &kp B   &kp N   &kp M   &kp COMMA &kp DOT &kp FSLH  &kp RSHFT &kp UP
// mods  (RAlt = 한/영 on Windows Korean IME)
&kp LCTRL &kp LGUI &kp LALT &kp RALT                          &kp RGUI &kp RCTRL &kp LEFT &kp DOWN &kp RIGHT
// thumbs: L1 L2 | R1 R2
&kp SPACE &mo FN                                              &kp SPACE &kp DEL
            >;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3     &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans                    &trans &trans &trans &trans &trans &trans &kp DEL
&trans &trans &trans &trans &trans &trans                           &trans &trans &trans &trans &kp PSCRN &trans &trans &trans
&trans &trans &trans &trans &trans &trans                           &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans &trans
&trans &trans &trans &trans &trans &trans                           &trans &trans &trans &trans &trans &trans &trans &kp PG_UP
&trans &trans &trans &trans                                         &trans &trans &kp HOME &kp PG_DN &kp END
&trans &trans                                                       &trans &trans
            >;
        };
    };
};
